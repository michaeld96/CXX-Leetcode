{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure cmake debug",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build", "-DCMAKE_BUILD_TYPE=Debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "build current problem",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "${fileBasenameNoExtension}"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["configure cmake debug"],
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}